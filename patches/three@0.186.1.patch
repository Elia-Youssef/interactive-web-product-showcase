+	/**
+	 * Deletes the vertex array objects of the cache whose key holds the id
+	 * of the given attribute, and resets the vertex binding if one of them
+	 * is bound. A VAO records the buffers of the attributes it was created
+	 * with, so a disposed attribute leaves every VAO holding its buffer
+	 * dangling; the cache is keyed by whole attribute lists, so the keys are
+	 * searched for the attribute's own segment.
+	 *
+	 * @private
+	 * @param {BufferAttribute} attribute - The buffer attribute to release.
+	 */
+	_releaseVaos( attribute ) {
+
+		const id = this.get( attribute ).id;
+
+		if ( id === undefined ) {
+
+			return;
+
+		}
+
+		const { gl, state } = this;
+		const segment = ':' + id + ':';
+		let boundReleased = false;
+
+		for ( const key of Object.keys( this.vaoCache ) ) {
+
+			if ( ( key + ':' ).includes( segment ) ) {
+
+				if ( state.currentVAO === this.vaoCache[ key ] ) {
+
+					boundReleased = true;
+
+				}
+
+				gl.deleteVertexArray( this.vaoCache[ key ] );
+
+				delete this.vaoCache[ key ];
+
+			}
+
+		}
+
+		if ( boundReleased === true ) {
+
+			state.resetVertexState();
+
+		}
+
+	}
+
