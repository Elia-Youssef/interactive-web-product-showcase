# Cache rules for the host. Bundled files carry a content hash in their name,
# so they never change under one URL. Every other shipped folder keeps stable
# file names and revalidates. HTML is not listed: it keeps the host default.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self' data:; connect-src 'self' blob:; worker-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=0, must-revalidate

/env/*
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=0, must-revalidate

/social/*
  Cache-Control: public, max-age=0, must-revalidate
