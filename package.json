{
  "name": "product-viewer-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.ts && node scripts/deployCheck.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "lint": "node tooling/lint.ts",
    "format": "node tooling/format.ts --write",
    "format:check": "node tooling/format.ts --check",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm assets:validate && pnpm build && pnpm e2e",
    "assets:fonts": "node scripts/copyFonts.ts",
    "assets:optimize": "node scripts/optimize.ts",
    "assets:validate": "node scripts/validate.ts",
    "assets:social": "pnpm build && node scripts/socialCapture.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "camera-controls": "3.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "4.0.1",
    "@csstools/css-tokenizer": "4.0.2",
    "@eslint/js": "10.0.1",
    "@fontsource/montserrat": "5.3.0",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "keyframe-resample": "0.1.0",
    "ktx-parse": "1.1.0",
    "meshoptimizer": "1.3.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
